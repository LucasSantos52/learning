          "descricao": {
            "maxLength": 1000,
            "minLength": 2,
            "type": "string"
          },
          "imagemUpload": {
            "type": "string",
            "format": "binary",
            "nullable": true
          },
          "imagem": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "dataCadastro": {
            "type": "string",
