          "nome",
          "valor"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fornecedorId": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "descricao": {
            "maxLength": 1000,
            "minLength": 2,
            "type": "string"
          },
          "imagemUpload": {
            "type": "string",
            "nullable": true
          },
          "imagem": {
            "type": "string",
            "nullable": true
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "dataCadastro": {
            "type": "string",
            "format": "date-time"
          },
          "ativo": {
            "type": "boolean"
          },
          "nomeFornecedor": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProdutoImagemDTO": {
        "required": [
